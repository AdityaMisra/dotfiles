# Generic "work laptop" overlay shipped with the public repo.
# Applied on top of the base Brewfile by install/08-host-overlay.sh
# when LocalHostName maps to "work-laptop".
#
# Anything employer-specific (internal CLIs, proprietary taps) belongs in
# hosts/<alias>.local/Brewfile.work which is gitignored.

brew "vault"          # HashiCorp Vault CLI
brew "opa"            # Open Policy Agent
brew "grpcui"         # interactive gRPC UI
brew "cookiecutter"   # project scaffolder
brew "terraform"
brew "tfenv"          # multiple terraform versions
brew "awscli"
brew "kubectl"
brew "helm"
