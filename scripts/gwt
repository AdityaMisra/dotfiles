#!/usr/bin/env bash
# usage: gwt add <branch> [base]    create a worktree at ../<repo>-<branch> (new branch from base if needed)
#        gwt switch <branch>        print the worktree path (use: cd "$(gwt switch <branch>)")
#        gwt rm <branch>            remove the worktree and delete the branch if merged
#        gwt list                   list worktrees
#
# Worktrees let you run several Claude Code sessions on one repo, each on its own branch,
# without them overwriting each other's files.
# end
source "$(dirname "$(readlink -f "$0")")/_lib.sh"
handle_help "$@"

cmd="${1:-list}"
shift || true

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"

# Always derive names from the main worktree, so gwt behaves the same from any worktree.
main_root="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
repo_name="$(basename "$main_root")"
parent="$(dirname "$main_root")"

# Path of the worktree that has <branch> checked out (handles paths with spaces).
worktree_for() {
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    /^worktree / { wt = substr($0, 10) }
    /^branch /   { if (substr($0, 8) == b) { print wt; exit } }
  '
}

case "$cmd" in
  add)
    branch="${1:?branch name required}"
    base="${2:-$(git symbolic-ref --short HEAD)}"
    target="$parent/${repo_name}-${branch//\//-}"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$target" "$branch"
    else
      git worktree add -b "$branch" "$target" "$base"
    fi
    log "worktree at $target"
    ;;
  switch)
    branch="${1:?branch name required}"
    target="$(worktree_for "$branch")"
    [[ -n "$target" ]] || die "no worktree for branch $branch"
    printf '%s\n' "$target"
    ;;
  rm)
    branch="${1:?branch name required}"
    target="$(worktree_for "$branch")"
    [[ -n "$target" ]] || die "no worktree for branch $branch"
    git worktree remove "$target"
    git branch -d "$branch" || warn "branch '$branch' kept (not merged yet; use git branch -D to force)"
    ;;
  list|ls)
    git worktree list
    ;;
  *) usage; exit 2 ;;
esac
