#!/usr/bin/env bash
# usage: note "<text>"     Append a timestamped line to ~/Notes/inbox.md
#        note              Open ~/Notes/inbox.md in $EDITOR
# end
source "$(dirname "$0")/_lib.sh"
handle_help "$@"

NOTES_DIR="${NOTES_DIR:-$HOME/Notes}"
INBOX="$NOTES_DIR/inbox.md"
mkdir -p "$NOTES_DIR"
[[ -f "$INBOX" ]] || printf '# Inbox\n\n' > "$INBOX"

if (( $# == 0 )); then
  "${EDITOR:-cursor}" "$INBOX"
  exit 0
fi

ts="$(date '+%Y-%m-%d %H:%M')"
printf -- '- [%s] %s\n' "$ts" "$*" >> "$INBOX"
log "appended to $INBOX"
