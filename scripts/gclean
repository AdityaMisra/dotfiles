#!/usr/bin/env bash
# usage: gclean [--yes]
# Deletes local branches already merged into the default branch.
# end
source "$(dirname "$0")/_lib.sh"
handle_help "$@"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"

default="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null \
  | sed 's@^origin/@@' || true)"
default="${default:-main}"

git fetch --prune origin

candidates="$(git branch --merged "origin/$default" \
  | sed 's/^[* ] //' \
  | grep -Ev "^(${default}|master|main|HEAD)$" || true)"

if [[ -z "$candidates" ]]; then
  log "nothing to clean"
  exit 0
fi

echo "Branches merged into origin/$default:"
echo "$candidates" | sed 's/^/  - /'

if [[ "${1:-}" != "--yes" ]]; then
  read -r -p "Delete these branches? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { log "aborted"; exit 0; }
fi

while read -r b; do
  git branch -d "$b"
done <<<"$candidates"
