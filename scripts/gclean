#!/usr/bin/env bash
# usage: gclean [--yes]
# Delete local branches that are already merged into the default branch (origin/HEAD,
# else origin/main or origin/master). Skips the current branch and branches checked
# out in other worktrees. Asks before deleting unless --yes is given.
# end
source "$(dirname "$(readlink -f "$0")")/_lib.sh"
handle_help "$@"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"
git fetch --prune origin

default="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)"
if [[ -z "$default" ]]; then
  for b in main master; do
    git show-ref --verify --quiet "refs/remotes/origin/$b" && { default=$b; break; }
  done
fi
[[ -n "$default" ]] || die "can't find the default branch (set it with: git remote set-head origin --auto)"

current="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
in_worktrees="$(git worktree list --porcelain | sed -n 's@^branch refs/heads/@@p')"

candidates=()
while IFS= read -r b; do
  [[ -z $b || $b == "$default" || $b == main || $b == master || $b == "$current" ]] && continue
  grep -qxF -- "$b" <<<"$in_worktrees" && continue
  candidates+=("$b")
done < <(git for-each-ref --merged "origin/$default" --format='%(refname:short)' refs/heads)

if (( ${#candidates[@]} == 0 )); then
  log "nothing to clean (no local branches merged into origin/$default)"
  exit 0
fi

echo "Branches merged into origin/$default:"
printf '  - %s\n' "${candidates[@]}"

if [[ "${1:-}" != "--yes" ]]; then
  read -r -p "Delete these branches? [y/N] " ans || ans=""
  [[ "$ans" =~ ^[Yy]$ ]] || { log "aborted"; exit 0; }
fi

for b in "${candidates[@]}"; do
  git branch -d "$b" || warn "could not delete $b"
done
